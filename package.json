{
  "name": "pi-agent-celld-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node src/jobs/bundle.ts",
    "dev": "CELLD_ESBUILD=node_modules/.bin/esbuild celld dev . --no-watch",
    "test": "node --test --experimental-transform-types 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
