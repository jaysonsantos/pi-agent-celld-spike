# Settings of this machine for the scripts. Copy this file to .env. Write each line as NAME=value, without quotes.

# Kubeconfig of the cluster that gets the release. Necessary.
SPIKE_KUBECONFIG=
# SOPS file with the key pair of the object store, in the keys access_key and secret_key. Necessary for an install.
S3_CREDENTIALS_FILE=
# URL of the S3-compatible object store, for example https://s3.example.com. scripts/install.sh gives it to the chart.
S3_ENDPOINT=
# Profile of the AWS CLI for the object store. Only scripts/uninstall.sh --purge-bucket uses it.
S3_AWS_PROFILE=
# Key of the model endpoint. scripts/install.sh passes it to the chart. Necessary when llm.api is not faux.
SPIKE_LLM_API_KEY=
