@@ -0,0 +1,67 @@
+import inspect
+import struct
+import unittest
+from unittest import mock
+
+import bmemcached
+from bmemcached.exceptions import MemcachedException
+from bmemcached.protocol import Protocol
+
+
+class ProtocolTouchTests(unittest.TestCase):
+    def test_public_clients_expose_touch_with_required_time(self):
+        self.assertIs(bmemcached.Client, bmemcached.ReplicatingClient)
+
+        for client_class in (bmemcached.Client, bmemcached.ReplicatingClient, bmemcached.DistributedClient):
+            with self.subTest(client_class=client_class.__name__):
+                parameters = inspect.signature(client_class.touch).parameters
+                self.assertEqual(("self", "key", "time"), tuple(parameters))
+                self.assertEqual(inspect.Parameter.empty, parameters["time"].default)
+                self.assertIn("seconds", client_class.touch.__doc__)
+                self.assertIn("True", client_class.touch.__doc__)
+                self.assertIn("False", client_class.touch.__doc__)
+
+    def setUp(self):
+        self.protocol = Protocol("localhost:11211")
+        self.response = (0x81, 0x1C, 0, 0, 0, Protocol.STATUS["success"], 0, 0, 0, None)
+
+    def test_touch_sends_binary_command_and_returns_success(self):
+        with (
+            mock.patch.object(self.protocol, "_send") as send,
+            mock.patch.object(self.protocol, "_get_response", return_value=self.response),
+        ):
+            self.assertTrue(self.protocol.touch("k\u00e9", 123))
+
+        request = send.call_args.args[0]
+        header = struct.unpack(Protocol.HEADER_STRUCT, request[: Protocol.HEADER_SIZE])
+        self.assertEqual(Protocol.MAGIC["request"], header[0])
+        self.assertEqual(0x1C, header[1])
+        self.assertEqual(3, header[2])
+        self.assertEqual(4, header[3])
+        self.assertEqual(7, header[6])
+        self.assertEqual(123, struct.unpack("!I", request[24:28])[0])
+        self.assertEqual("k\u00e9".encode(), request[28:])
+
+    def test_touch_uses_maximum_expiration_for_negative_time(self):
+        with (
+            mock.patch.object(self.protocol, "_send") as send,
+            mock.patch.object(self.protocol, "_get_response", return_value=self.response),
+        ):
+            self.assertTrue(self.protocol.touch("key", -1))
+
+        request = send.call_args.args[0]
+        self.assertEqual(Protocol.MAXIMUM_EXPIRE_TIME, struct.unpack("!I", request[24:28])[0])
+
+    def test_touch_not_found_or_disconnected_returns_false(self):
+        for status in (Protocol.STATUS["key_not_found"], Protocol.STATUS["server_disconnected"]):
+            response = (*self.response[:5], status, *self.response[6:])
+            with self.subTest(status=status), mock.patch.object(self.protocol, "_get_response", return_value=response):
+                self.assertFalse(self.protocol.touch("missing", 10))
+
+    def test_touch_unexpected_status_raises(self):
+        response = (*self.response[:5], Protocol.STATUS["key_exists"], *self.response[6:])
+        with (
+            mock.patch.object(self.protocol, "_get_response", return_value=response),
+            self.assertRaises(MemcachedException),
+        ):
+            self.protocol.touch("key", 10)
